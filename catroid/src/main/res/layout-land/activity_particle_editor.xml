<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="horizontal">

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/preview_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="8dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_replay_particle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_material_button"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/stage_dialog_button_restart"
                app:backgroundTint="@null"
                app:tint="@color/accent" />

            <ImageButton
                android:id="@+id/btn_pick_gallery_bg"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_material_button"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/file_present_24px"
                app:backgroundTint="@null"
                app:tint="@color/accent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="#99000000"
            android:orientation="horizontal"
            android:padding="4dp">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_gizmo_gravity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/particle_editor_gizmo_gravity"
                android:textColor="@color/solid_white"
                android:textSize="10sp" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_gizmo_angle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/particle_editor_gizmo_angle"
                android:textColor="@color/solid_white"
                android:textSize="10sp" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_gizmo_posvar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/particle_editor_gizmo_posvar"
                android:textColor="@color/solid_white"
                android:textSize="10sp" />
        </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/toolbar_background"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/particle_editor_title"
                android:textColor="@color/solid_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_undo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Undo"
                android:padding="6dp"
                android:src="@drawable/icon_undo"
                app:tint="@color/accent" />

            <ImageButton
                android:id="@+id/btn_redo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Redo"
                android:padding="6dp"
                android:rotationY="180"
                android:src="@drawable/icon_undo"
                app:tint="@color/accent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_particle"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/particle_editor_save"
                android:textColor="@color/app_background_dark"
                android:textSize="11sp"
                app:backgroundTint="@color/accent" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="120dp">

            <include layout="@layout/include_particle_editor_controls" />
        </ScrollView>
    </LinearLayout>

</LinearLayout>
