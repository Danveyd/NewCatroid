<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit_size_curve"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="@string/particle_curve_size"
            android:textColor="@color/accent"
            android:textSize="10sp"
            app:strokeColor="@color/accent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit_spin_curve"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="@string/particle_curve_spin"
            android:textColor="@color/accent"
            android:textSize="10sp"
            app:strokeColor="@color/accent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit_alpha_curve"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="@string/particle_curve_alpha"
            android:textColor="@color/accent"
            android:textSize="10sp"
            app:strokeColor="@color/accent" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_graph_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="10dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/separator"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_active_graph_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/particle_curve_size"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/graph_view_container"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_graph_zoom_in"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="@string/particle_graph_zoom_in"
                    android:textColor="@color/solid_white"
                    android:textSize="10sp"
                    app:backgroundTint="@color/button_background" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_graph_zoom_out"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:text="@string/particle_graph_zoom_out"
                    android:textColor="@color/solid_white"
                    android:textSize="10sp"
                    app:backgroundTint="@color/button_background" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_graph_add_point"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:text="@string/particle_graph_add_point"
                    android:textColor="@color/app_background_dark"
                    android:textSize="10sp"
                    app:backgroundTint="@color/accent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_graph_delete_point"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:text="@string/particle_graph_delete_point"
                    android:textColor="@color/red"
                    android:textSize="10sp"
                    app:strokeColor="@color/red" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/particle_graph_easing"
                    android:textColor="@color/solid_white"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/spinner_graph_easing"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_material_input" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/particle_graph_variance"
                    android:textColor="@color/solid_white"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/et_point_variance"
                    android:layout_width="60dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_material_input"
                    android:hint="± Var"
                    android:inputType="numberDecimal"
                    android:padding="4dp"
                    android:textColor="@color/solid_white"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="10dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/separator"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/particle_section_main"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/particle_emitter_mode"
                android:textColor="@color/solid_white"
                android:textSize="11sp" />

            <Spinner
                android:id="@+id/spinner_emitter_mode"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_material_input" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/particle_emission_rate"
                        android:textColor="@color/solid_white"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/et_emission_rate"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_material_input"
                        android:inputType="numberDecimal"
                        android:padding="6dp"
                        android:textColor="@color/solid_white"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/particle_max_particles"
                        android:textColor="@color/solid_white"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/et_max_particles"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_material_input"
                        android:inputType="number"
                        android:padding="6dp"
                        android:textColor="@color/solid_white"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/particle_duration"
                        android:textColor="@color/solid_white"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/et_duration"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_material_input"
                        android:inputType="numberSigned|numberDecimal"
                        android:padding="6dp"
                        android:textColor="@color/solid_white"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/particle_respawn_delay"
                        android:textColor="@color/solid_white"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/et_respawn_delay"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_material_input"
                        android:inputType="numberDecimal"
                        android:padding="6dp"
                        android:textColor="@color/solid_white"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/particle_lifetime"
                        android:textColor="@color/solid_white"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/et_lifetime"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_material_input"
                        android:inputType="numberDecimal"
                        android:padding="6dp"
                        android:textColor="@color/solid_white"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/particle_lifetime_var"
                        android:textColor="@color/solid_white"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/et_lifetime_var"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_material_input"
                        android:inputType="numberDecimal"
                        android:padding="6dp"
                        android:textColor="@color/solid_white"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/particle_fade_in"
                        android:textColor="@color/solid_white"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/et_fade_in"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_material_input"
                        android:inputType="numberDecimal"
                        android:padding="6dp"
                        android:textColor="@color/solid_white"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/particle_fade_out"
                        android:textColor="@color/solid_white"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/et_fade_out"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_material_input"
                        android:inputType="numberDecimal"
                        android:padding="6dp"
                        android:textColor="@color/solid_white"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="10dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/separator"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/particle_section_spawn"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <org.catrobat.catroid.particles.ui.MaterialSliderView
                android:id="@+id/slider_pos_var_x"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp" />

            <org.catrobat.catroid.particles.ui.MaterialSliderView
                android:id="@+id/slider_pos_var_y"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_physics_gravity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="10dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/separator"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/particle_section_physics_gravity"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <org.catrobat.catroid.particles.ui.MaterialSliderView
                android:id="@+id/slider_speed"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/particle_slider_speed_var"
                    android:textColor="@color/solid_white"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/et_speed_var"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_material_input"
                    android:inputType="numberDecimal"
                    android:padding="4dp"
                    android:textColor="@color/solid_white"
                    android:textSize="12sp" />
            </LinearLayout>

            <org.catrobat.catroid.particles.ui.MaterialSliderView
                android:id="@+id/slider_angle"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/particle_slider_angle_var"
                    android:textColor="@color/solid_white"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/et_angle_var"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_material_input"
                    android:inputType="numberDecimal"
                    android:padding="4dp"
                    android:textColor="@color/solid_white"
                    android:textSize="12sp" />
            </LinearLayout>

            <org.catrobat.catroid.particles.ui.MaterialSliderView
                android:id="@+id/slider_gravity_x"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp" />

            <org.catrobat.catroid.particles.ui.MaterialSliderView
                android:id="@+id/slider_gravity_y"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="4dp" />

            <org.catrobat.catroid.particles.ui.MaterialSliderView
                android:id="@+id/slider_radial_accel"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp" />

            <org.catrobat.catroid.particles.ui.MaterialSliderView
                android:id="@+id/slider_tangential_accel"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="4dp" />

            <org.catrobat.catroid.particles.ui.MaterialSliderView
                android:id="@+id/slider_friction"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_physics_radius"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="10dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/separator"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/particle_section_physics_radius"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <org.catrobat.catroid.particles.ui.MaterialSliderView
                android:id="@+id/slider_start_radius"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp" />

            <org.catrobat.catroid.particles.ui.MaterialSliderView
                android:id="@+id/slider_end_radius"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="4dp" />

            <org.catrobat.catroid.particles.ui.MaterialSliderView
                android:id="@+id/slider_rotate_per_sec"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="10dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/separator"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/particle_section_color"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/particle_start_color"
                        android:textColor="@color/solid_white"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_start_color"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:text="@string/particle_select_color"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/particle_end_color"
                        android:textColor="@color/solid_white"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_end_color"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:text="@string/particle_select_color"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="10dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/separator"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/particle_section_texture"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_current_texture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/particle_texture_default"
                android:textColor="@color/solid_white"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_select_project_texture"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/particle_btn_project_files"
                    android:textColor="@color/accent"
                    android:textSize="10sp"
                    app:strokeColor="@color/accent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_import_texture"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/particle_btn_import_photo"
                    android:textColor="@color/solid_white"
                    android:textSize="10sp"
                    app:backgroundTint="@color/advertising_button_background" />
            </LinearLayout>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_is_additive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:text="@string/particle_additive_blending"
                android:textColor="@color/solid_white"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/particle_fbo_buffer"
                android:textColor="@color/solid_white"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/et_buffer_name"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_material_input"
                android:hint="@string/particle_fbo_hint"
                android:inputType="text"
                android:padding="6dp"
                android:textColor="@color/solid_white"
                android:textColorHint="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
